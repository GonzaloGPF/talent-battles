DEBUGBAR_ENABLED=false
APP_NAME="Talent Battles"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://talentbattles.test
APP_SERVICE=talentbattles.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talentbattles
DB_USERNAME=talentbattles
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@talentbattles.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

#https://randomkeygen.com
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_ENV='${APP_ENV}'
VITE_APP_DEBUG='${APP_DEBUG}'
VITE_REVERB_APP_KEY='${REVERB_APP_KEY}'
VITE_REVERB_HOST='${REVERB_HOST}'
VITE_REVERB_PORT='${REVERB_PORT}'
VITE_REVERB_SCHEME='${REVERB_SCHEME}'
VITE_BROADCAST_DRIVER='${BROADCAST_DRIVER}'
VITE_STRIPE_KEY='${STRIPE_KEY}'

STRIPE_ENABLED=true
STRIPE_KEY=your-stripe-key
STRIPE_SECRET=your-stripe-secret
STRIPE_WEBHOOK_SECRET=null
STRIPE_SIGNATURE_VERIFY=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
