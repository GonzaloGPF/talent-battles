			message: '#^Call to an undefined method ProtoneMedia\\LaravelFFMpeg\\Exporters\\MediaExporter\:\:setAdditionalParameters\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Objects/FFMpegManager.php
