{
  "extends": "stylelint-config-recommended",
  "customSyntax": "postcss-scss",
  "plugins": [
    "stylelint-scss"
  ],
  "ignoreFiles": [
    "node_modules"
  ],
  "rules": {
    "at-rule-no-unknown": null,
    "no-invalid-double-slash-comments": null,
    "at-rule-prelude-no-invalid": null,
    "scss/at-rule-no-unknown": [ true, {
      "ignoreAtRules": [
        "extends",
        "tailwind",
        "layer"
      ]
    }]
  }
}
