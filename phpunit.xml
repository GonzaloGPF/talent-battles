<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <extensions>
    <bootstrap class="Tests\Extensions\Bootstrap"/>
  </extensions>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
  <php>
    <ini name="memory_limit" value="1024M"/>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_CONTACT_EMAIL" value="some@mail.com"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="DB_DATABASE" value="testing"/>
    <env name="FILESYSTEM_DRIVER" value="local"/>
    <env name="BROADCAST_DRIVER" value="null"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
    <env name="DEBUGBAR_ENABLED" value="false"/>
    <env name="STRIPE_ENABLED" value="true"/>
  </php>  
</phpunit>
