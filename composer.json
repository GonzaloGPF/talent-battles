{
    "name": "gonzalogpf/talent-battles",
    "type": "project",
    "description": "TalentBattles source code",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.403",
        "guzzlehttp/guzzle": "^7.16",
        "intervention/image": "^4.0",
        "laravel/cashier": "^16.9",
        "laravel/framework": "^13.40",
        "laravel/horizon": "^5.50",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "larecipe/larecipe": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "pbmedia/laravel-ffmpeg": "^8.9",
        "staudenmeir/eloquent-has-many-deep": "^1.22",
        "tucker-eric/eloquentfilter": "^3.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.8",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.4",
        "jetbrains/phpstorm-attributes": "^1.3",
        "larastan/larastan": "^3.14",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/globals.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "clear": "php artisan clear-compiled && php artisan config:clear && php artisan cache:clear",
        "helper": "composer clear && php artisan ide-helper:generate && php artisan ide-helper:models -M && php artisan ide-helper:meta",
        "lint": "composer php-lint && composer js-lint && composer style-lint",
        "php-lint": "vendor/bin/pint",
        "js-lint": "npm run js-lint",
        "style-lint": "npm run style-lint",
        "analyse": "vendor/bin/phpstan analyse",
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "authors": [
        {
            "name": "Gonzalo Pabón Flores",
            "email": "zalo.pabon@gmail.com",
            "role": "Developer"
        }
    ]
}
